language js

`$x` as $s where {
  or {
    and { $s <: JsAssignmentExpression(left=$l), $l <: r"(?s)process\.env.*" },
    and { $s <: JsUnaryExpression(), $s <: r"(?s)delete .*process\.env.*" },
    $s <: `Object.assign(process.env, $_)`,
    $s <: `process.chdir($_)`
  },
  register_diagnostic(span=$s, message="Never write process.env or call process.chdir: the cwd is Session state and child environments are built per spawn (architecture: State ownership, interfaces §9).")
}
