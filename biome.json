{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!docs", "!research-cache", "!test/fixtures", "!schema", "!src/tui/vendor", "!.claude"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "error"
      },
      "style": { "noNonNullAssertion": "error" },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["src/**", "!src/**/*.test.ts"],
      "plugins": ["./scripts/lint/no-module-state.grit", "./scripts/lint/no-process-writes.grit"]
    },
    {
      "includes": ["src/agent/transcript/build.ts", "src/agent/transcript/fingerprint.ts"],
      "plugins": ["./scripts/lint/no-nondeterminism.grit"]
    }
  ]
}
