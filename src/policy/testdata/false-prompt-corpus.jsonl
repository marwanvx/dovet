{"language": "bash", "command": "ls *.ts", "expect": "read-only", "source": "AC-PERM-21 (permissions.md)"}
{"language": "bash", "command": "cd {root} && git status", "expect": "read-only", "source": "AC-PERM-21 (permissions.md)"}
{"language": "bash", "command": "cut -d / -f1 a.ts", "expect": "read-only", "source": "AC-PERM-21 (permissions.md)"}
{"language": "bash", "command": "awk '{print $1}' a.ts", "expect": "read-only", "source": "AC-PERM-21 (permissions.md)"}
