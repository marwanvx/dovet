{
  "name": "dovet",
  "version": "0.0.0",
  "description": "A terminal coding agent that can't hide what it did, what it cost, or what it was told.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marwanvx/dovet.git"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "release": "bun scripts/build-release.ts --all",
    "gen:schemas": "bun scripts/gen-schemas.ts",
    "check": "bun check -b && bun run lint && bun run lint:deps && bun run test && bun run spec:coverage && bun run docs:check && bun run wiring",
    "wiring": "bun scripts/wiring.ts",
    "lint": "biome check .",
    "lint:deps": "bun --bun depcruise src --config .dependency-cruiser.cjs",
    "test": "bun scripts/test-run.ts",
    "spec:coverage": "bun scripts/spec-coverage.ts",
    "docs:boxes": "bun scripts/docs-context.ts",
    "docs:check": "bun scripts/check-docs.ts",
    "next": "bun scripts/next.ts",
    "auto": "bun scripts/auto.ts",
    "record": "bun scripts/record.ts",
    "probe": "bun scripts/probe.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "@types/turndown": "5.0.6",
    "dependency-cruiser": "18.6.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.71",
    "@anthropic-ai/sandbox-runtime": "0.0.80",
    "@mozilla/readability": "0.6.0",
    "ai": "7.0.143",
    "get-east-asian-width": "1.7.0",
    "guarded-fetch": "0.1.6",
    "ignore": "7.0.12",
    "jsonc-parser": "3.3.1",
    "linkedom": "0.18.13",
    "marked": "18.1.1",
    "pdf-lib": "1.17.1",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-powershell": "0.26.4",
    "turndown": "7.2.4",
    "unpdf": "1.9.1",
    "web-tree-sitter": "0.27.1",
    "zod": "4.6.7"
  }
}
