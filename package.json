{
  "name": "dovet",
  "version": "0.0.0",
  "description": "A terminal coding agent that can't hide what it did, what it cost, or what it was told.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marwanvx/dovet.git"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "release": "bun scripts/build-release.ts --all",
    "gen:schemas": "bun scripts/gen-schemas.ts",
    "check": "bun check -b && bun run lint && bun run lint:deps && bun run test && bun run spec:coverage && bun run docs:check",
    "lint": "biome check .",
    "lint:deps": "bun --bun depcruise src --config .dependency-cruiser.cjs",
    "test": "bun test --check",
    "spec:coverage": "bun scripts/spec-coverage.ts",
    "docs:boxes": "bun scripts/docs-context.ts",
    "docs:check": "bun scripts/check-docs.ts",
    "next": "bun scripts/next.ts",
    "record": "bun scripts/record.ts",
    "probe": "bun scripts/probe.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "dependency-cruiser": "18.5.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.68",
    "@anthropic-ai/sandbox-runtime": "0.0.79",
    "ai": "7.0.138",
    "get-east-asian-width": "1.6.0",
    "jsonc-parser": "3.3.1",
    "marked": "18.0.11",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-powershell": "0.26.4",
    "web-tree-sitter": "0.27.1",
    "zod": "4.6.7"
  }
}
