{
  "name": "dovet",
  "version": "0.0.0",
  "description": "A terminal coding agent that can't hide what it did, what it cost, or what it was told.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marwanvx/dovet.git"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "bun run typecheck && bun run lint && bun run lint:deps && bun run test && bun run spec:coverage && bun run docs:check",
    "typecheck": "bun check",
    "lint": "biome check .",
    "lint:deps": "bun --bun depcruise src --config .dependency-cruiser.cjs",
    "test": "bun test --check",
    "spec:coverage": "bun scripts/spec-coverage.ts",
    "docs:boxes": "bun scripts/docs-context.ts",
    "docs:check": "bun scripts/check-docs.ts",
    "next": "bun scripts/next.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "dependency-cruiser": "18.5.0",
    "typescript": "6.0.3"
  }
}
